#!/usr/bin/env bash
# leetcode wrapper: feed code on stdin, run a LeetCode CLI command against it.
#
#   leetcode-code <id> test   < solution.rkt
#   leetcode-code <id> exec   < solution.rkt
#   leetcode-code <id> watch  < solution.rkt
#
# The CLI itself only reads the solution from its own code directory, so this
# writes stdin to that file first, then delegates.

set -euo pipefail

REAL=${LEETCODE_CLI:-/run/current-system/sw/bin/leetcode}
ROOT=${LEETCODE_ROOT:-$HOME/.leetcode}

usage() {
  echo "usage: $(basename "$0") <id> <test|exec|watch> [extra args...]" >&2
  exit 2
}

[ $# -ge 2 ] || usage
id=$1
cmd=$2
shift 2

# Turns "csrf = \"x\"" / "root = \"y\"" pairs into shell assignments.
toml_get() {
  awk -v key="$1" '
    $1 == key && $2 == "=" { gsub(/"/, "", $3); print $3; exit }
  ' "$ROOT/leetcode.toml"
}

code_dir=$(toml_get code)
code_dir=${code_dir:-code}
storage_root=$(toml_get root)
storage_root=${storage_root:-$ROOT}
storage_root=${storage_root/#\~/$HOME}
dir="$storage_root/$code_dir"

# The CLI names the file <fid>.<slug>.<ext>. Reuse the existing one so the
# slug (and the extension, whether the suffix fix is installed or not) stays
# whatever the CLI already generated.
target=$(find "$dir" -maxdepth 1 -name "$id.*" ! -name "*.tests.dat" 2>/dev/null | head -1)

if [ -z "$target" ]; then
  # Nothing generated yet: let the CLI create it, then find it.
  EDITOR=true "$REAL" edit "$id" >/dev/null 2>&1 || true
  target=$(find "$dir" -maxdepth 1 -name "$id.*" ! -name "*.tests.dat" 2>/dev/null | head -1)
fi

if [ -z "$target" ]; then
  echo "$(basename "$0"): could not resolve a solution file for $id" >&2
  exit 1
fi

code=$(cat)
if [ -n "$code" ]; then
  printf '%s\n' "$code" > "$target"
fi

exec "$REAL" "$cmd" "$id" "$@"
